# 서버 전용 환경변수입니다. NEXT_PUBLIC_ 접두사를 사용하지 마세요.
LOSTARK_API_KEY=
EXIM_SERVICE_KEY=

# 공공데이터포털(data.go.kr) 일반 인증키 — 에어코리아·기상청 단기예보에 공통 사용.
# 두 API를 각각 활용신청(자동 승인)해야 합니다. 인코딩/디코딩 키 모두 허용됩니다.
DATA_GO_KR_SERVICE_KEY=
# 선택: 에어코리아 서울 측정소명 (기본값 "중구")
AIRKOREA_STATION=

# 거래장 아이템과 환율 통화는 대시보드 화면에서 선택합니다.
